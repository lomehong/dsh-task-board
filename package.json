{
  "name": "@dsh-extra/dsh-task-board",
  "version": "0.1.0",
  "description": "任务看板：任务中心化的看板与调度执行——Host 权威账本、cron 调度、真实分身会话执行、账本裁决闭环",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ledger": {
      "types": "./lib/types/ledger.d.ts",
      "default": "./lib/ledger.js"
    },
    "./cron": {
      "types": "./lib/types/cron.d.ts",
      "default": "./lib/cron.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client.js": "./lib/client.js"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "scripts/**"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "build:client": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
